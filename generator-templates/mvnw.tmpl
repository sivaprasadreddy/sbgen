#!/bin/sh
set -eu

if command -v mvn >/dev/null 2>&1; then
  exec mvn "$@"
fi

BASE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
MAVEN_VERSION={{ .MavenVersion }}
MAVEN_CACHE=${MAVEN_USER_HOME:-"$HOME/.m2"}/wrapper/dists/apache-maven-$MAVEN_VERSION
MAVEN_HOME=$MAVEN_CACHE/apache-maven-$MAVEN_VERSION

if [ ! -x "$MAVEN_HOME/bin/mvn" ]; then
  mkdir -p "$MAVEN_CACHE"
  ARCHIVE=$MAVEN_CACHE/apache-maven-$MAVEN_VERSION-bin.zip
  if [ ! -f "$ARCHIVE" ]; then
    curl -fsSL "https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$MAVEN_VERSION/apache-maven-$MAVEN_VERSION-bin.zip" -o "$ARCHIVE"
  fi
  unzip -q -o "$ARCHIVE" -d "$MAVEN_CACHE"
fi

exec "$MAVEN_HOME/bin/mvn" -f "$BASE_DIR/pom.xml" "$@"
