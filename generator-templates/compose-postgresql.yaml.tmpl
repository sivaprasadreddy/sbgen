services:
  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_DB: {{ .DatabaseName }}
      POSTGRES_USER: {{ .DatabaseName }}
      POSTGRES_PASSWORD: {{ .DatabaseName }}
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ .DatabaseName }} -d {{ .DatabaseName }}"]
      interval: 10s
      timeout: 5s
      retries: 5
