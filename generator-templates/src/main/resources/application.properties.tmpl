spring.application.name={{ .ArtifactID }}
spring.datasource.url={{ .DatasourceURL }}
spring.datasource.driver-class-name={{ .DatasourceDriver }}
{{- if .ExternalDatasource }}
spring.datasource.username=${DATABASE_USERNAME}
spring.datasource.password=${DATABASE_PASSWORD}
{{- end }}
{{- if .FlywayEnabled }}
spring.flyway.locations=classpath:db/migration
{{- end }}
{{- if .LiquibaseEnabled }}
spring.liquibase.change-log=classpath:db/changelog/db.changelog-master.xml
{{- end }}
{{- if .OAuthResourceServer }}
spring.security.oauth2.resourceserver.jwt.jwk-set-uri=${OAUTH2_JWK_SET_URI:http://localhost:9000/oauth2/jwks}
{{- end }}
{{- if .MailEnabled }}
spring.mail.host=${MAIL_HOST:localhost}
spring.mail.port=${MAIL_PORT:1025}
spring.mail.username=${MAIL_USERNAME:}
spring.mail.password=${MAIL_PASSWORD:}
{{- end }}
{{- if .CloudAWSEnabled }}
spring.cloud.aws.region.static=${AWS_REGION:us-east-1}
{{- end }}
{{- if .DockerComposeH2 }}
spring.docker.compose.enabled=false
{{- end }}
