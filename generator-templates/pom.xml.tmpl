<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
    https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>{{ .SpringBootVersion }}</version>
    <relativePath/>
  </parent>
  <groupId>{{ xml .GroupID }}</groupId>
  <artifactId>{{ xml .ArtifactID }}</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>{{ xml .ArtifactID }}</name>
  <properties>
    <java.version>{{ .JavaVersion }}</java.version>
    <spotless.version>{{ .SpotlessVersion }}</spotless.version>
    <palantir-java-format.version>{{ .PalantirFormatVersion }}</palantir-java-format.version>
    <jacoco.version>{{ .JacocoVersion }}</jacoco.version>
    <git-commit-id.version>{{ .GitCommitIDVersion }}</git-commit-id.version>
{{- if .HasModulith }}
    <spring-modulith.version>{{ .SpringModulithVersion }}</spring-modulith.version>
{{- end }}
{{- if .HasCloudAWS }}
    <spring-cloud-aws.version>{{ .SpringCloudAWSVersion }}</spring-cloud-aws.version>
{{- end }}
  </properties>
  <dependencies>
{{- range .Dependencies }}
    <dependency>
      <groupId>{{ .GroupID }}</groupId>
      <artifactId>{{ .ArtifactID }}</artifactId>
{{- if .Scope }}
      <scope>{{ .Scope }}</scope>
{{- end }}
{{- if .Optional }}
      <optional>true</optional>
{{- end }}
    </dependency>
{{- end }}
  </dependencies>
{{- if or .HasModulith .HasCloudAWS }}
  <dependencyManagement>
    <dependencies>
{{- if .HasModulith }}
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
{{- end }}
{{- if .HasCloudAWS }}
      <dependency>
        <groupId>io.awspring.cloud</groupId>
        <artifactId>spring-cloud-aws-dependencies</artifactId>
        <version>${spring-cloud-aws.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
{{- end }}
    </dependencies>
  </dependencyManagement>
{{- end }}
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <version>${git-commit-id.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>revision</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <failOnNoGitDirectory>false</failOnNoGitDirectory>
          <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
          <generateGitPropertiesFile>true</generateGitPropertiesFile>
          <includeOnlyProperties>
            <includeOnlyProperty>^git.branch$</includeOnlyProperty>
            <includeOnlyProperty>^git.commit.id.abbrev$</includeOnlyProperty>
            <includeOnlyProperty>^git.commit.user.name$</includeOnlyProperty>
            <includeOnlyProperty>^git.commit.message.full$</includeOnlyProperty>
          </includeOnlyProperties>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <importOrder/>
            <removeUnusedImports/>
            <palantirJavaFormat>
              <version>${palantir-java-format.version}</version>
            </palantirJavaFormat>
            <formatAnnotations/>
          </java>
          <pom>
            <sortPom>
              <keepBlankLines>false</keepBlankLines>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
