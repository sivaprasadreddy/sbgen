import org.gradle.api.tasks.testing.logging.TestExceptionFormat
import org.gradle.api.tasks.testing.logging.TestLogEvent
import org.springframework.boot.gradle.tasks.bundling.BootBuildImage

plugins {
    java
    jacoco
    id("org.springframework.boot") version {{ quote .SpringBootVersion }}
    id("com.gorylenko.gradle-git-properties") version {{ quote .GitPropertiesVersion }}
    id("com.diffplug.spotless") version {{ quote .SpotlessVersion }}
}

group = {{ quote .GroupID }}
version = "0.0.1-SNAPSHOT"

val archunitVersion = {{ quote .ArchunitVersion }}
{{- if .Angular }}
val springdocOpenapiVersion = {{ quote .SpringdocVersion }}
{{- end }}
{{- if .HasCloudAWS }}
val springBootFlociTcVersion = {{ quote .FlociVersion }}
{{- end }}

java {
    toolchain {
        languageVersion.set(JavaLanguageVersion.of({{ .JavaVersion }}))
    }
}

repositories {
    mavenCentral()
}

dependencies {
    implementation("org.springframework.boot:spring-boot-starter-webmvc")
{{- if .Thymeleaf }}
    implementation("org.springframework.boot:spring-boot-starter-thymeleaf")
    implementation("nz.net.ultraq.thymeleaf:thymeleaf-layout-dialect")
{{- end }}
{{- if .Angular }}
    implementation("org.springdoc:springdoc-openapi-starter-webmvc-ui:${property("springdocOpenapiVersion")}")
{{- end }}
{{- if .JPA }}
    implementation("org.springframework.boot:spring-boot-starter-data-jpa")
{{- else }}
    implementation("org.springframework.boot:spring-boot-starter-jdbc")
{{- end }}
{{- if .PostgreSQL }}
    runtimeOnly("org.postgresql:postgresql")
{{- end }}
{{- if .MySQL }}
    runtimeOnly("com.mysql:mysql-connector-j")
{{- end }}
{{- if .MariaDB }}
    runtimeOnly("org.mariadb.jdbc:mariadb-java-client")
{{- end }}
{{- if .H2 }}
    runtimeOnly("com.h2database:h2")
{{- end }}
{{- if .Flyway }}
    implementation("org.springframework.boot:spring-boot-starter-flyway")
{{- if .PostgreSQL }}
    runtimeOnly("org.flywaydb:flyway-database-postgresql")
{{- end }}
{{- if or .MySQL .MariaDB }}
    runtimeOnly("org.flywaydb:flyway-mysql")
{{- end }}
{{- end }}
{{- if .Liquibase }}
    implementation("org.springframework.boot:spring-boot-starter-liquibase")
{{- end }}
{{- if .Secured }}
    implementation("org.springframework.boot:spring-boot-starter-security")
    {{- if .Thymeleaf }}
    implementation("org.thymeleaf.extras:thymeleaf-extras-springsecurity6")
    {{- end }}
{{- end }}
{{- if .OAuth }}
    implementation("org.springframework.boot:spring-boot-starter-oauth2-resource-server")
{{- end }}
{{- if .Email }}
    implementation("org.springframework.boot:spring-boot-starter-mail")
{{- end }}
{{- if .HasModulith }}
    implementation("org.springframework.modulith:spring-modulith-starter-core")
{{- end }}
{{- if .HasCloudAWS }}
    implementation("io.awspring.cloud:spring-cloud-aws-starter-s3")
{{- end }}

    developmentOnly("org.springframework.boot:spring-boot-devtools")
    annotationProcessor("org.springframework.boot:spring-boot-configuration-processor")
{{- if .DockerCompose }}
    developmentOnly("org.springframework.boot:spring-boot-docker-compose")
{{- end }}

    testRuntimeOnly("org.junit.platform:junit-platform-launcher")
    testImplementation("org.springframework.boot:spring-boot-starter-webmvc-test")
    {{- if .JPA }}
    testImplementation("org.springframework.boot:spring-boot-starter-data-jpa-test")
    {{- else }}
    testImplementation("org.springframework.boot:spring-boot-starter-jdbc-test")
    {{- end }}
    {{- if .Secured }}
    testImplementation("org.springframework.boot:spring-boot-starter-security-test")
    {{- end }}
{{- if .HasModulith }}
    testImplementation("org.springframework.modulith:spring-modulith-starter-test")
{{- end }}
{{- if .HasCloudAWS }}
    testImplementation("io.floci:spring-boot-testcontainers-floci:${property("springBootFlociTcVersion")}")
{{- end }}
{{- if .Testcontainers }}
    testImplementation("org.springframework.boot:spring-boot-testcontainers")
    testImplementation("org.testcontainers:testcontainers-junit-jupiter")
{{- if .PostgreSQL }}
    testImplementation("org.testcontainers:testcontainers-postgresql")
{{- end }}
{{- if .MySQL }}
    testImplementation("org.testcontainers:testcontainers-mysql")
{{- end }}
{{- if .MariaDB }}
    testImplementation("org.testcontainers:testcontainers-mariadb")
{{- end }}
{{- end }}
    testImplementation("com.tngtech.archunit:archunit-junit5:${property("archunitVersion")}")
}

dependencyManagement {
    imports {
        {{- if .HasCloudAWS }}
        mavenBom("io.awspring.cloud:spring-cloud-aws-dependencies:${property("SpringCloudAWSVersion")}")
        {{- end }}
        {{- if .HasModulith }}
        mavenBom("org.springframework.modulith:spring-modulith-bom:${property("SpringModulithVersion")}")
        {{- end }}
    }
}

tasks.test {
    useJUnitPlatform()
    testLogging {
        events(
            TestLogEvent.PASSED,
            TestLogEvent.SKIPPED,
            TestLogEvent.FAILED,
            //TestLogEvent.STANDARD_OUT,
            TestLogEvent.STANDARD_ERROR
        )
        exceptionFormat = TestExceptionFormat.FULL
        showExceptions = true
        showCauses = true
        showStackTraces = true
    }
    finalizedBy(tasks.jacocoTestReport)
}

jacoco {
    toolVersion = {{ quote .JacocoVersion }}
}

val jacocoExclusions = listOf("**/Application.class")

tasks.jacocoTestReport {
    dependsOn(tasks.test)
    reports {
        xml.required.set(true)
        html.required.set(true)
        csv.required.set(false)
    }
    classDirectories.setFrom(files(classDirectories.files.map {
        fileTree(it) { exclude(jacocoExclusions) }
    }))
}

tasks.jacocoTestCoverageVerification {
    dependsOn(tasks.test)
    violationRules {
        rule {
            limit {
                counter = "LINE"
                value = "COVEREDRATIO"
                minimum = {{ .JacocoMinimumCoverage }}.toBigDecimal()
            }
        }
    }
    classDirectories.setFrom(files(classDirectories.files.map {
        fileTree(it) { exclude(jacocoExclusions) }
    }))
}

tasks.check {
    dependsOn(tasks.jacocoTestCoverageVerification)
}

springBoot {
    buildInfo()
}

tasks.named<BootBuildImage>("bootBuildImage") {
    imageName.set("your_dockerhub_username/{{ .ArtifactID }}")
}

gitProperties {
    failOnNoGitDirectory = false
    keys = listOf("git.branch", "git.commit.id.abbrev", "git.commit.user.name", "git.commit.message.full")
}

spotless {
    java {
        importOrder()
        removeUnusedImports()
        palantirJavaFormat({{ quote .PalantirFormatVersion }})
        formatAnnotations()
    }
}
