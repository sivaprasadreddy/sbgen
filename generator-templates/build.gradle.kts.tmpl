plugins {
    java
    jacoco
    id("org.springframework.boot") version {{ quote .SpringBootVersion }}
    id("com.gorylenko.gradle-git-properties") version {{ quote .GitPropertiesVersion }}
    id("com.diffplug.spotless") version {{ quote .SpotlessVersion }}
}

group = {{ quote .GroupID }}
version = "0.0.1-SNAPSHOT"

java {
    toolchain {
        languageVersion.set(JavaLanguageVersion.of({{ .JavaVersion }}))
    }
}

repositories {
    mavenCentral()
}

dependencies {
    implementation(platform("org.springframework.boot:spring-boot-dependencies:{{ .SpringBootVersion }}"))
{{- if .HasModulith }}
    implementation(platform("org.springframework.modulith:spring-modulith-bom:{{ .SpringModulithVersion }}"))
{{- end }}
{{- if .HasCloudAWS }}
    implementation(platform("io.awspring.cloud:spring-cloud-aws-dependencies:{{ .SpringCloudAWSVersion }}"))
{{- end }}
{{- range .Dependencies }}
    {{ .GradleConfiguration }}({{ quote .Coordinate }}){{ if .Optional }} // optional runtime dependency{{ end }}
{{- end }}
}

tasks.test {
    useJUnitPlatform()
    finalizedBy(tasks.jacocoTestReport)
}

jacoco {
    toolVersion = {{ quote .JacocoVersion }}
}

tasks.jacocoTestReport {
    dependsOn(tasks.test)
    reports {
        xml.required.set(true)
        html.required.set(true)
        csv.required.set(false)
    }
}

gitProperties {
    failOnNoGitDirectory = false
    keys = listOf("git.branch", "git.commit.id.abbrev", "git.commit.user.name", "git.commit.message.full")
}

spotless {
    java {
        importOrder()
        removeUnusedImports()
        palantirJavaFormat({{ quote .PalantirFormatVersion }})
        formatAnnotations()
    }
}
