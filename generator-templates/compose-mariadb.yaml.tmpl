services:
  mariadb:
    image: mariadb:11.8
    environment:
      MARIADB_DATABASE: {{ .DatabaseName }}
      MARIADB_USER: {{ .DatabaseName }}
      MARIADB_PASSWORD: {{ .DatabaseName }}
      MARIADB_ROOT_PASSWORD: root
    ports:
      - "3306:3306"
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
