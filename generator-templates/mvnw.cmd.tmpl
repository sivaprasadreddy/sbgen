@echo off
where mvn >nul 2>nul
if %ERRORLEVEL% EQU 0 (
  mvn %*
  exit /b %ERRORLEVEL%
)

set "MAVEN_VERSION={{ .MavenVersion }}"
if "%MAVEN_USER_HOME%"=="" set "MAVEN_USER_HOME=%USERPROFILE%\.m2"
set "MAVEN_CACHE=%MAVEN_USER_HOME%\wrapper\dists\apache-maven-%MAVEN_VERSION%"
set "MAVEN_HOME=%MAVEN_CACHE%\apache-maven-%MAVEN_VERSION%"
if not exist "%MAVEN_HOME%\bin\mvn.cmd" (
  if not exist "%MAVEN_CACHE%" mkdir "%MAVEN_CACHE%"
  powershell -NoProfile -ExecutionPolicy Bypass -Command "$url='https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/%MAVEN_VERSION%/apache-maven-%MAVEN_VERSION%-bin.zip'; $zip='%MAVEN_CACHE%\apache-maven-%MAVEN_VERSION%-bin.zip'; if (-not (Test-Path $zip)) { Invoke-WebRequest -UseBasicParsing $url -OutFile $zip }; Expand-Archive -Force $zip '%MAVEN_CACHE%'"
  if %ERRORLEVEL% NEQ 0 exit /b %ERRORLEVEL%
)
call "%MAVEN_HOME%\bin\mvn.cmd" -f "%~dp0pom.xml" %*
