services:
{{ if .PostgreSQL }}
  postgres:
    image: postgres:17-alpine
    environment:
      POSTGRES_DB: {{ .DatabaseName }}
      POSTGRES_USER: {{ .DatabaseName }}
      POSTGRES_PASSWORD: {{ .DatabaseName }}
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ .DatabaseName }} -d {{ .DatabaseName }}"]
      interval: 10s
      timeout: 5s
      retries: 5
{{ end }}
{{ if .Floci }}
  floci:
    image: floci/floci:latest-compat
    ports:
      - "4566:4566"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./src/test/resources/floci-init/ready.d:/etc/floci/init/ready.d:ro
    environment:
      AWS_DEFAULT_REGION: us-east-1
{{ end }}
{{ if .MySQL }}
  mysql:
    image: mysql:8.4
    environment:
      MYSQL_DATABASE: {{ .DatabaseName }}
      MYSQL_USER: {{ .DatabaseName }}
      MYSQL_PASSWORD: {{ .DatabaseName }}
      MYSQL_ROOT_PASSWORD: root
    ports:
      - "3306:3306"
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h localhost -u root -p$$MYSQL_ROOT_PASSWORD"]
      interval: 10s
      timeout: 5s
      retries: 5
{{ end }}
{{ if .MariaDB }}
  mariadb:
    image: mariadb:11.8
    environment:
      MARIADB_DATABASE: {{ .DatabaseName }}
      MARIADB_USER: {{ .DatabaseName }}
      MARIADB_PASSWORD: {{ .DatabaseName }}
      MARIADB_ROOT_PASSWORD: root
    ports:
      - "3306:3306"
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
{{ end }}
