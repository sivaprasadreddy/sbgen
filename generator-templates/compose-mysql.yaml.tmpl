services:
  mysql:
    image: mysql:8.4
    environment:
      MYSQL_DATABASE: {{ .DatabaseName }}
      MYSQL_USER: {{ .DatabaseName }}
      MYSQL_PASSWORD: {{ .DatabaseName }}
      MYSQL_ROOT_PASSWORD: root
    ports:
      - "3306:3306"
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h localhost -u root -p$$MYSQL_ROOT_PASSWORD"]
      interval: 10s
      timeout: 5s
      retries: 5
